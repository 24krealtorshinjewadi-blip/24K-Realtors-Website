# Google Gemini AI Studio API Key (for Property AI search / chat)
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# API Base URL (leave empty in local dev if using Vite proxy)
# For production (e.g. Vercel), set to your Railway backend URL:
# VITE_API_BASE_URL=https://twentyfourk-backend-production.up.railway.app/api/v1
