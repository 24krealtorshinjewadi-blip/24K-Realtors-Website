# ════════════════════════════════════════════════════════════════
# 24K Realtors — Backend Environment Variables Template
# ════════════════════════════════════════════════════════════════
# ⚠️  NEVER commit real values. This example file is safe to commit.
# Set values directly in Railway Dashboard > Variables
# or copy to `.env.local` for local dev.
# ================================================================

# ── Resend Email API ─────────────────────────────────────────────
# REQUIRED — App will NOT start without this.
# Get from: https://resend.com/api-keys
# ⚠️  ROTATE IMMEDIATELY if previously committed to git.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY

# Sender address (must be a verified Resend domain in production)
RESEND_FROM=24K Realtors <noreply@24krealtors.com>

# ── Twilio SMS OTP ───────────────────────────────────────────────
# Optional — Fast2SMS is cheaper for India
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Fast2SMS (Indian SMS - Recommended over Twilio) ──────────────
# Get from: https://www.fast2sms.com → API → Dev API Key
FAST2SMS_API_KEY=

# ── WhatsApp Business API ────────────────────────────────────────
# REQUIRED for WhatsApp lead notifications
# Get Token from: Meta Business Manager → WhatsApp → API Access
# Replace PHONE_NUMBER_ID with your actual WhatsApp Business phone number ID
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages
# ⚠️  Permanent access token from Meta — never hardcode in source
WHATSAPP_API_TOKEN=REPLACE_WITH_META_PERMANENT_TOKEN
WHATSAPP_API_TEMPLATE=welcome_lead_intro

# ── JWT Authentication ───────────────────────────────────────────
# REQUIRED — App will NOT start without this.
# Generate: openssl rand -base64 64
# ⚠️  Changing this will invalidate ALL existing user sessions.
JWT_SECRET=REPLACE_WITH_64_CHAR_BASE64_SECRET_FROM_OPENSSL
JWT_EXPIRATION_MS=86400000

# ── Admin Account ────────────────────────────────────────────────
# REQUIRED — Use a strong password: min 16 chars, mixed case + numbers + symbols
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_16_CHARS

# ── AWS S3 Media Storage ─────────────────────────────────────────
# Bucket: twentyfourk-realestate-media | Region: ap-south-1 (Mumbai)
AWS_S3_BUCKET=twentyfourk-realestate-media
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BASE_URL=https://twentyfourk-realestate-media.s3.ap-south-1.amazonaws.com

# ── Application Profile ──────────────────────────────────────────
# 'railway' on Railway | 'prod' for standard prod | 'dev' for local
SPRING_PROFILES_ACTIVE=railway
