# CODEOWNERS
# Defines who is automatically requested for review when a PR changes specific files.
# Format: <pattern>  <owner(s)>
# Docs: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# ─────────────────────────────────────────
# Global fallback — all files
# ─────────────────────────────────────────
*                                       @manishrai99-afk

# ─────────────────────────────────────────
# Backend (Spring Boot / Java)
# ─────────────────────────────────────────
/backend/                               @manishrai99-afk
/backend/src/main/java/**/*.java        @manishrai99-afk
/backend/pom.xml                        @manishrai99-afk

# ─────────────────────────────────────────
# Database Migrations (Critical — always review)
# ─────────────────────────────────────────
/backend/src/main/resources/db/migration/**  @manishrai99-afk

# ─────────────────────────────────────────
# Security Configuration (Extra care)
# ─────────────────────────────────────────
/backend/src/main/java/**/security/**   @manishrai99-afk
/backend/src/main/java/**/config/SecurityConfig.java  @manishrai99-afk

# ─────────────────────────────────────────
# Frontend (React / Vite)
# ─────────────────────────────────────────
/frontend/                              @manishrai99-afk
/frontend/src/**/*.jsx                  @manishrai99-afk
/frontend/src/**/*.js                   @manishrai99-afk
/frontend/package.json                  @manishrai99-afk

# ─────────────────────────────────────────
# CI/CD & Infrastructure
# ─────────────────────────────────────────
/.github/                               @manishrai99-afk
/Dockerfile*                            @manishrai99-afk
/docker-compose*.yml                    @manishrai99-afk

# ─────────────────────────────────────────
# Environment & Secrets Configuration
# ─────────────────────────────────────────
/.env*                                  @manishrai99-afk
/backend/src/main/resources/application*.yml  @manishrai99-afk
